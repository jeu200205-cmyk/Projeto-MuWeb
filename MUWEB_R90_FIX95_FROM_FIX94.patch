+assert.equal(h2.itemModelPath,'Item/ExplicitItem.bmd'); assert.equal(h2.objectModelPath,'Skill/ExplicitObject.bmd');
+console.log('PASS FIX95 CharacterHelper Data/Item vs Data/Skill runtime model ownership');
