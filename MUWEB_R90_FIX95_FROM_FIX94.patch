+import assert from 'node:assert/strict';
+import {parseCharacterHelperLua} from './data/CharacterHelperLua.js';
+const rows=parseCharacterHelperLua(`
+SetHelper(GET_ITEM(13,80), 0, 2, 20.5, 0.8, 0.9, 1, 0.4, 2.0, "PetWolf", "PetWolfObj")
+SetHelper(GET_ITEM(13,81), 1, 0, 0, 1.1, 1.2, 0, 0.5, 1.0, "MountItem", "MountObject")
+SetHelper(GET_ITEM(13,82), 2, 0, 0, 1.0, 1.0, 0, 0.5, 1.0, "Data\\Item\\ExplicitItem", "Data\\Skill\\ExplicitObject")
