# MU Network Infrastructure - Environment Variables
# Copie para .env e ajuste conforme necessário

# Gateway WebSocket
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9091

# ConnectServer (Gateway principal para clientes)
CONNECT_SERVER_HOST=127.0.0.1
CONNECT_SERVER_PORT=44405

# GameServers (podem ser múltiplos)
GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_PORT=55901

# JoinServer (Autenticação)
JOIN_SERVER_HOST=127.0.0.1
JOIN_SERVER_PORT=55970

# DataServer (Persistência)
DATA_SERVER_HOST=127.0.0.1
DATA_SERVER_PORT=55960

# Database
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=MuOnline
DB_USER=sa
DB_PASSWORD=

# Logging
LOG_LEVEL=info

# Métricas Prometheus
METRICS_PORT=9092

# Diretório dos servidores MU
MU_SERVER_DIR=C:\Users\jeu\Documents\Nova pasta\mu-server