+import assert from 'node:assert/strict';
+import { routeMUPacket } from '../protocol/MUPacketRouter.js';
+
+function packet(body) { return { headcode:0xF3, subcode:0xE0, payload:body, opcodeName:'CHARACTER' }; }
+function put32(a,o,v){ a[o]=v&255; a[o+1]=(v>>>8)&255; a[o+2]=(v>>>16)&255; a[o+3]=(v>>>24)&255; }
+function valid(n){
+  const a=new Uint8Array(n); a[0]=0x34; a[1]=0x12;
+  for(let o=4;o<=80;o+=4) put32(a,o,(0x10000000+o)>>>0);
+  if(n===144){ for(let o=84;o<=140;o+=4) put32(a,o,(0x20000000+o)>>>0); }
+  return a;
+}
+for (const n of [84,144]) {
+  let got=null; const r=routeMUPacket(packet(valid(n)),{onNewCharacterInfo:m=>got=m});
+  assert.equal(r,'new_character_info'); assert.ok(got); assert.equal(got.level,0x1234);
+  assert.equal(got.resetValid,n===144);
+  if(n===144) assert.equal(got.reset,0x20000000+84);
+}
+for (const n of [0,1,83,85,100,143,145,168]) {
+  let called=0; const r=routeMUPacket(packet(new Uint8Array(n)),{onNewCharacterInfo:()=>called++});
+  assert.equal(r,'payload_short',`length ${n}`); assert.equal(called,0,`atomic ${n}`);
+}
+console.log('PASS FIX80 F3:E0 exact 84/144-byte authoritative contract');
