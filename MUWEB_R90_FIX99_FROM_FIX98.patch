+    p.pos[0]+=(Math.random()*.8-.4)*fScale;
+    p.pos[1]+=(Math.random()*.8-.4)*fScale;
+    p.pos[2]+=2.5*fScale;
+    if(p.subtype===0)p.scale-=.05;else p.scale*=.98;
+  }else if(p.kind==='fire'){
+    p.gravity+=.004;p.pos[2]+=p.gravity*10;
+    if(p.subtype===0)p.scale-=.04;else p.scale+=p.gravity;
+  }else{
