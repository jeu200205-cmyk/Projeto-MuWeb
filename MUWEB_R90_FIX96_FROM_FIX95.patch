+const fs = require('node:fs');
+const path = require('node:path');
+const crypto = require('node:crypto');
+const root = path.resolve(__dirname, '..');
+const MUTABLE_RUNTIME = new Set(['runtime-config.js']);
+function sha256(p){return crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');}
+function verifyBuild(){
+  const manifestPath = path.join(root, 'R90_FIX96_SOURCE_HASHES.json');
+  if(!fs.existsSync(manifestPath)) throw new Error('R90_FIX96_SOURCE_HASHES.json ausente');
+  const m = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
+  let n=0;
+  for(const [rel, expected] of Object.entries(m.files || {})){
+    if(MUTABLE_RUNTIME.has(rel)) continue;
+    const p = path.join(root, rel);
+    if(!fs.existsSync(p)) throw new Error(`FIX96 arquivo ausente: ${rel}`);
+    const actual = sha256(p);
+    if(actual !== expected) throw new Error(`FIX96 arquivo modificado/incompleto: ${rel}`);
+    n++;
+  }
+  console.log(`[R90 FIX96] ${m.build}: ${n} arquivos imutaveis verificados.`);
+  return m;
+}
+module.exports={verifyBuild};
+if(require.main===module){
+  try{
+    verifyBuild();
+    if(process.argv.includes('--verify-only')) process.exit(0);
+    require('./start-r90-safe.cjs').main().catch(e=>{console.error('[R90 FIX96] FALHA:', e.message); process.exitCode=1;});
+  }catch(e){console.error('[R90 FIX96] FALHA:', e.message); process.exitCode=1;}
+}
