+const fs = require('node:fs');
+const path = require('node:path');
+const crypto = require('node:crypto');
+const root = path.resolve(__dirname, '..');
+const MUTABLE_RUNTIME = new Set(['runtime-config.js']);
+function sha256(p){return crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');}
+function verifyBuild(){
+  const manifestPath = path.join(root, 'R90_FIX97_SOURCE_HASHES.json');
+  if(!fs.existsSync(manifestPath)) throw new Error('R90_FIX97_SOURCE_HASHES.json ausente');
+  const m = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
+  let n=0;
+  for(const [rel, expected] of Object.entries(m.files || {})){
+    if(MUTABLE_RUNTIME.has(rel)) continue;
+    const p = path.join(root, rel);
